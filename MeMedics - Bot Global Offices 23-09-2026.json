    },
    {
      "parameters": {
        "description": "Ele determina se é Bom dia, Boa tarde ou Boa noite conforme a hora do dia (fusos horários de São Paulo) e adiciona esse campo saudacao em cada item do fluxo.",
        "jsCode": "// Pega todos os itens de entrada\nconst items = $input.all();\n\n// Pega a hora atual (0-23) usando Luxon/$now\nconst hour = $now.hour; // se quiser forçar fuso: $now.setZone('America/Sao_Paulo').hour\n\nlet greeting = 'Boa noite'; // default\n\nif (hour >= 5 && hour < 12) {\n  greeting = 'Bom dia';\n} else if (hour >= 12 && hour < 18) {\n  greeting = 'Boa tarde';\n}\n\n// Adiciona o campo em cada item\nfor (const item of items) {\n  item.json.saudacao = greeting;\n}\n\nreturn items;\n"
      },
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.3,
