    {
      "parameters": {
        "jsCode": "function estaNoHorarioDeAtendimento() {\n  const agora = $now; // Luxon DateTime do n8n\n  const diaSemana = agora.weekday; // 1 = segunda, ..., 6 = sábado, 7 = domingo\n  const minutosAgora = agora.hour * 60 + agora.minute;\n\n  const inicio = 8 * 60;   // 08:00\n  const fimSemana = 20 * 60; // 20:00\n  const fimSabado = 14 * 60; // 14:00\n\n  if (diaSemana >= 1 && diaSemana <= 5) {\n    return minutosAgora >= inicio && minutosAgora < fimSemana;\n  }\n\n  if (diaSemana === 6) {\n    return minutosAgora >= inicio && minutosAgora < fimSabado;\n  }\n\n  return false; // domingo\n}\n\nreturn [\n  {\n    json: {\n      emHorarioAtendimento: estaNoHorarioDeAtendimento()\n    }\n  }\n];"
      },
